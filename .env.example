# -------------------------------------------------------------
# 🌐 SOLAR BATTERY HEALTH MONITOR - ENVIRONMENT TEMPLATE
# Copy this file to .env and insert your real credentials:
# cp .env.example .env
# -------------------------------------------------------------

# 1. Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Telegram Alert Recipients (comma-separated Chat IDs from @userinfobot)
TELEGRAM_CHAT_IDS=YOUR_CHAT_ID_1,YOUR_CHAT_ID_2

# 3. Google Gemini AI API Key (Optional: free from https://aistudio.google.com)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
